{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://thzytrtjhsaqwtbqlwyi.supabase.co/auth/v1",
    "resource_name": "Grästorps IK HockeyEttan MCP",
    "accepted_audiences": [
      "authenticated"
    ],
    "jwks_uri": "https://thzytrtjhsaqwtbqlwyi.supabase.co/auth/v1/.well-known/jwks.json"
  },
  "mcp": {
    "server": {
      "name": "grastorps-ik-mcp",
      "version": "0.1.0",
      "title": "Grästorps IK HockeyEttan MCP"
    },
    "tools": [
      {
        "name": "get_todays_matchup",
        "title": "Today's HockeyEttan matchup",
        "description": "Return the HockeyEttan Södra matchup on a given date (defaults to today, Europe/Stockholm) for a given team (defaults to Grästorps IK). Returns null if the team is not playing that date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date": {
              "description": "ISO date YYYY-MM-DD. Defaults to today in Europe/Stockholm.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "team": {
              "description": "Team name filter. Defaults to Grästorps IK.",
              "type": "string"
            },
            "season": {
              "description": "Season label, e.g. '2025-26'.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_standings",
        "title": "HockeyEttan Södra standings",
        "description": "Return the current league standings for HockeyEttan Södra for the given season (defaults to current).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "season": {
              "description": "Season label, e.g. '2025-26'.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_head_to_head",
        "title": "All-time head-to-head",
        "description": "Return all-time HockeyEttan head-to-head record between two teams across known seasons.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "home": {
              "type": "string",
              "minLength": 1,
              "description": "Home team name, e.g. 'Grästorps IK'."
            },
            "away": {
              "type": "string",
              "minLength": 1,
              "description": "Away team name."
            }
          },
          "required": [
            "home",
            "away"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
